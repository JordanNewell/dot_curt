            "id": "call_65f02478b0d247638fb44d50",
            "name": "Bash",
            "arguments": {
              "command": "powershell -NoProfile -Command '\n$udp = New-Object System.Net.Sockets.UdpClient\n$udp.EnableBroadcast = $true\n$udp.Client.ReceiveTimeout = 4000\n$msg = [Text.Encoding]::ASCII.GetBytes(\"M-SEARCH * HTTP/1.1`r`nHOST: 239.255.255.250:1900`r`nMAN: `\"ssdp:discover`\"`r`nMX: 3`r`nST: ssdp:all`r`n`r`n\")\n$bytes = $udp.Send($msg, $msg.Length, [Net.IPEndPoint]::new([Net.IPAddress]::Broadcast, 1900))\ntry {\n  $end = [DateTime]::Now.AddSeconds(4)\n  while ([DateTime]::Now -lt $end) {\n    $ep = New-Object Net.IPEndPoint([Net.IPAddress]::Any, 0)\n    $r = [Text.Encoding]::ASCII.GetString($udp.Receive([ref]$ep))\n    if ($r -match \"Xbox|XboxOne|XboxSeries\") { \"=== $($ep.Address) ===\"; $r }\n  }\n} catch {}\n$udp.Close()' 2>&1 | head -60",
              "description": "SSDP broadcast scan for Xbox consoles on LAN"
            }
