            "arguments": {
              "command": "for i in $(seq 1 254); do (ping -n 1 -w 150 192.168.137.$i > /dev/null &); done; sleep 9; arp -a | grep -A20 \"192.168.137.1 \" | grep dynamic",
              "description": "Sweep ICS subnet for the 360"
            }
          }
        ]
      },
      {
        "id": "66009db2-8339-4e21-8dfa-e39300be3434-tool",
