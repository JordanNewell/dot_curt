				"id": "m4",
				"role": "user",
				"content": "Show me what an extension field looks like.",
				"timestamp": 1760000060000
			},
			{
				"id": "m5",
				"role": "assistant",
				"content": "Writers attach extra fields anywhere. This message carries an images-inline attachment; readers that ignore it still see the plain text below.",
